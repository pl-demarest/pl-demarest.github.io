{
  "name": "github-landing",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.183.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.3",
    "vitest": "^5.1.0"
  }
}
